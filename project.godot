; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Gusanos"
run/main_scene="res://main_screen/game_screen.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[audio]

buses/default_bus_layout="uid://donifoacab0wt"

[autoload]

GlobalManager="*uid://b3vvixi15d8h8"
Inventory="*res://commons/inventory.gd"
ItemInventory="*res://commons/items/item_inventory.gd"
Shop="*res://commons/shop.gd"
DragManager="*res://commons/social/drag_manager.gd"
UpgradeManager="*res://commons/upgrades/upgrade_manager.gd"
AudioManager="*res://commons/audio/audio_manager.gd"
PlayerEffects="*res://commons/effects/player_effects.gd"

[display]

window/stretch/mode="canvas_items"

[editor_plugins]

enabled=PackedStringArray("res://addons/finite_state_machine/plugin.cfg")

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
