[ext_resource type="Script" path="res://commons/skills/obsidian_skill.gd" id="1_obsidian"]

[resource]
script = ExtResource("1_obsidian")
skill_name = "Corazón de Obsidiana"
description = "Forjada en las entrañas de un volcán, su piel de obsidiana rechaza el daño y absorbe la vida de sus enemigos. Un tanque imparable que se fortalece con el sufrimiento."
