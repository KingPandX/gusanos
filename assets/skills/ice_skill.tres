[ext_resource type="Script" path="res://commons/skills/ice_skill.gd" id="1_ice"]

[resource]
script = ExtResource("1_ice")
skill_name = "Escarcha Eterna"
description = "Una capa de hielo eterno recubre su cuerpo. Reduce 20% el daño recibido y ralentiza 30% la velocidad de ataque de cualquier enemigo que se atreva a golpearlo."
